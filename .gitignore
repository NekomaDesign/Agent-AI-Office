# Trạng thái sống & sản phẩm của studio — giữ trên máy, không đẩy lên GitHub
# (brief khách hàng, chat, output có thể là dữ liệu riêng tư).
# Muốn sao lưu lên GitHub thì xoá các dòng tương ứng bên dưới.
.studio/status/*.json
.studio/tasks.json
.studio/chat/*.jsonl
.studio/reports/*.md
.studio/archive/*
.studio/session.json
.studio/usage.jsonl
!.studio/archive/.gitkeep
outputs/*
inputs/
!outputs/.gitkeep

